# ============================================================
# InsightIQ — environment template
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` (it is git-ignored).
# All keys are used SERVER-SIDE ONLY and are never sent to the browser.
# ============================================================

# --- Database (Prisma + SQLite) ---
DATABASE_URL="file:./db/custom.db"

# --- AI provider keys: Gemini 6 slots + Groq 3 slots (pooling, rate-limit rotation) ---
GEMINI_API_KEY_1=YOUR_GEMINI_API_KEY_1
GEMINI_API_KEY_2=YOUR_GEMINI_API_KEY_2
GEMINI_API_KEY_3=YOUR_GEMINI_API_KEY_3
GEMINI_API_KEY_4=YOUR_GEMINI_API_KEY_4
GEMINI_API_KEY_5=YOUR_GEMINI_API_KEY_5
GEMINI_API_KEY_6=YOUR_GEMINI_API_KEY_6
GROQ_API_KEY_1=YOUR_GROQ_API_KEY_1
GROQ_API_KEY_2=YOUR_GROQ_API_KEY_2
GROQ_API_KEY_3=YOUR_GROQ_API_KEY_3

# --- Optional overrides (sensible defaults are built in) ---
# Shared secret that authorizes the Express backend to call the Next.js
# internal AI fallback proxy (/api/ai/llm, /api/ai/vision). Generate with:
#   openssl rand -hex 24
# INTERNAL_AI_PROXY_TOKEN=change_me_random_hex
# Absolute path to a Python interpreter that has pandas/numpy/scipy.
# Leave unset to auto-detect.
# PYTHON_PATH=/usr/bin/python3
# MAX_FILE_SIZE_MB=100
# MAX_ROWS=100000
# MAX_COLUMNS=500
# MAX_VIDEO_MB=100
# MAX_VIDEO_SECONDS=600
# MAX_FRAMES=10
# ANALYTICS_TIMEOUT_MS=180000
# AI_TIMEOUT_MS=45000
# AI_MAX_RETRIES=2
# AI_DAILY_REQUEST_BUDGET=2000
# FILE_RETENTION_HOURS=72
# LOG_LEVEL=info
